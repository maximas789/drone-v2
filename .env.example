# Ajniha — environment template. Copy to `.env` and fill in.
# No values here are real. `.env` itself is gitignored.

# --- Database (F03) -------------------------------------------------------
# Docker Postgres locally, Neon in production. Needed at BUILD time too:
# `pnpm build` runs `db:migrate` first.
POSTGRES_URL=

# --- Auth (F05) -----------------------------------------------------------
# Generate once: `openssl rand -base64 32`. Rotating it invalidates sessions.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

# --- App ------------------------------------------------------------------
# Baked into QR codes, canonical links, the sitemap and the OG card AT RENDER
# TIME. If this still says localhost in production, every printed sticker is dead.
APP_URL=

# --- Email (F06) — optional ----------------------------------------------
# Without a key, emails print to the terminal and are still logged in-app.
RESEND_API_KEY=
EMAIL_FROM=

# --- Uploads (F07) — optional --------------------------------------------
# Unset uses the local-folder driver.
BLOB_READ_WRITE_TOKEN=

# --- Background jobs (F08) — optional ------------------------------------
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --- Peppers — generate ONCE, never regenerate ---------------------------
# Changing either orphans every hash already stored.
ID_HASH_PEPPER=
RATE_LIMIT_PEPPER=
