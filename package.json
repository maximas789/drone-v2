    "vendor:map": "node scripts/vendor-map-assets.mts",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/lib/seed/index.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@mapbox/mapbox-gl-rtl-text": "^0.4.0",
    "@vercel/blob": "^2.8.0",
    "better-auth": "^1.6.29",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "inngest": "^4.18.1",
    "lucide-react": "^1.31.0",
    "maplibre-gl": "^6.4.1",
    "next": "16.3.1",
    "next-intl": "^4.13.6",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-email": "^6.9.2",
    "resend": "^6.20.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.18.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
