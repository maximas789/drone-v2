{
  "name": "ajniha",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "pnpm db:migrate && next build",
    "start": "next start",
    "lint": "eslint && node scripts/i18n-check.mts",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
